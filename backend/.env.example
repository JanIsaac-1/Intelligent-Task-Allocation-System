# ==============================================================================
# LOCAL DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================================================
DB_NAME=geotask_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# DJANGO BACKEND SECURITY
# ==============================================================================
DJANGO_SECRET_KEY=django-insecure-geotask-ics-strathmore-secret-key-2026-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
